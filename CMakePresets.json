{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC)",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "native",
      "displayName": "Native host toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native"
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64" },
    { "name": "native-release", "configurePreset": "native", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } },
    { "name": "native", "configurePreset": "native", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
